{
  "name": "my-world",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --clean --platform android",
    "prebuild:ios": "expo prebuild --clean --platform ios",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "bundle:ios": "npx expo export --platform ios",
    "bundle:android": "npx expo export --platform android",
    "bundle:analyze": "npx expo export --platform ios --dump-sourcemap && npx source-map-explorer dist/_expo/static/js/ios/*.js --html bundle-report.html",
    "bundle:stats": "npx expo export --platform ios && node scripts/analyze-bundle.mjs"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.6.0",
    "@turf/boolean-intersects": "^7.3.4",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "@turf/buffer": "^7.3.4",
    "@turf/centroid": "^7.3.4",
    "@turf/difference": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "@turf/union": "^7.3.4",
    "@turf/bbox": "^7.3.4",
    "@turf/area": "^7.3.4",
    "@turf/simplify": "^7.3.4",
    "earcut": "^3.0.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.0",
    "expo-font": "~14.0.0",
    "expo-gl": "~16.0.0",
    "expo-haptics": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^3.2.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "uuid": "^11.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/earcut": "^2.1.4",
    "@types/geojson": "^7946.0.14",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.0",
    "@types/three": "^0.170.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/uuid": "^10.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.9.0"
  }
}
